generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String
}

model Review {
  id          String   @id @default(uuid())
  name        String
  role        String?
  description String
  profileUrl  String?
  starCount   Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model HeroSlide {
  id        String   @id @default(uuid())
  order     Int      @unique
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  desc      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

