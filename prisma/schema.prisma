generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String

  verifiedPayments  Payment[]            @relation("PaymentVerifiedBy")
  orderStatusEvents OrderStatusHistory[] @relation("OrderStatusChangedBy")
}

model Review {
  id          String   @id @default(uuid())
  name        String
  role        String?
  description String
  profileUrl  String?
  starCount   Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([starCount])
}

model HeroSlide {
  id        String   @id @default(uuid())
  order     Int      @unique
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([createdAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  desc      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Product {
  id                  String               @id @default(uuid())
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imgUrl              String
  name                String
  slug                String               @unique
  smallDesc           String
  stock               Boolean              @default(true)
  type                String[]
  plans               ProductPlan[]
  variants            ProductVariant[]
  longDesc            String?
  features            Json?
  homeSectionProducts HomeSectionProduct[]
  orderItems          OrderItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([categoryId])
  @@index([stock])
  @@index([name])
  @@index([slug])
  @@index([createdAt])
}

model HomeSection {
  id                  String               @id @default(uuid())
  title               String
  desc                String
  tag                 String
  homeSectionProducts HomeSectionProduct[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([createdAt])
}

model HomeSectionProduct {
  id            String      @id @default(uuid())
  homeSectionId String
  homeSection   HomeSection @relation(fields: [homeSectionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([homeSectionId, productId])
  @@index([homeSectionId])
  @@index([productId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Product plans (replaces the old Product.plans JSON column)
// ─────────────────────────────────────────────

/// A group of plans inside a product, e.g. "Mobile", "Desktop / TV" (each with its own 1/3/12-month plans).
model ProductVariant {
  id          String        @id @default(uuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  description String?
  inStock     Boolean       @default(true)
  sortOrder   Int           @default(0)
  plans       ProductPlan[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model ProductPlan {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// null = plan without a variant (simple products)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal         @db.Decimal(10, 2)
  durationDays Int?
  validity     String?
  inStock      Boolean         @default(true)
  sortOrder    Int             @default(0)
  orderItems   OrderItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

// ─────────────────────────────────────────────
// Customers & orders
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING_VERIFICATION
  PAID
  REJECTED
  REFUNDED
}

enum PaymentMethodType {
  BKASH
  NAGAD
  ROCKET
}

enum PaymentRecordStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  whatsapp  String
  country   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsapp])
  @@index([createdAt])
}

model Order {
  id          String   @id @default(uuid())
  seq         Int      @unique @default(autoincrement())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Snapshot of the details entered at checkout
  customerName  String
  customerEmail String
  customerPhone String
  country       String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING_VERIFICATION)

  currency String  @default("BDT")
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  customerNote String?
  adminNote    String?

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?
  cancelledAt DateTime?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  planId    String?
  plan      ProductPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time
  productName      String
  productSlug      String
  productImgUrl    String?
  variantName      String?
  planName         String
  planDurationDays Int?
  planValidity     String?

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)
  lineTotal Decimal @db.Decimal(10, 2)

  // License key / account credentials delivered by admin
  deliveryDetails String?
  deliveredAt     DateTime?
  /// deliveredAt + planDurationDays — set on delivery, indexed for the subscription-alerts page
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([planId])
  @@index([expiresAt])
}

model Payment {
  id              String              @id @default(uuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethodType
  senderNumber    String
  trxId           String              @unique
  amount          Decimal             @db.Decimal(10, 2)
  status          PaymentRecordStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?               @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  changedBy   User?        @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// Admin-managed receiving accounts shown on the checkout page
model PaymentMethod {
  id            String            @id @default(uuid())
  method        PaymentMethodType @unique
  accountNumber String
  accountType   String            @default("Personal")
  instructions  String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}
